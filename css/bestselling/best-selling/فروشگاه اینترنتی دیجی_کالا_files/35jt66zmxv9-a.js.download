e:"@eligoldgallery",category:"طلا و جواهر",followers:"۹۳۴ هزار",logo:"https://dkstatics-public.digikala.com/digikala-admin-landing/ba88fc3057556fd5794e4422bcfe83d23c93c2dd_1785669376.png?x-oss-process=image/quality,q_60"}],_=[{value:40,suffix:"+ میلیون",label:"کاربر فعال ماهانه"},{value:7,suffix:"+ میلیون",label:"بازدید روزانه"},{value:50,suffix:"+ هزار",label:"فروشنده فعال"},{value:1e3,suffix:"+ شهر",label:"پوشش ارسال سراسری"}],m=[{icon:"action-users",title:"دسترسی به میلیون‌ها خریدار",desc:"کالاهای شما در معرض دید مشتریان فعال دیجی‌کالا قرار می‌گیرد."},{icon:"shipping-express",title:"ارسال متناسب با کسب‌وکار شما",options:[{icon:"shipping-express",color:"brand/primary-base",label:"ارسال توسط دیجی‌کالا"},{icon:"badge-delivery-ship-by-seller",color:"rating/very-poor",label:"ارسال توسط فروشنده"},{icon:"shipping-3h",color:"rating/very-poor",label:"ارسال ۳ ساعته"}]},{icon:"shop-order",title:"پنل مدیریت فروش",desc:"مدیریت سفارش‌ها، موجودی، قیمت‌گذاری و عملکرد فروش، یکجا."},{icon:"action-chart",title:"تسویه منظم به همراه گزارش‌های شفاف مالی",desc:"تسویه‌های منظم ۵تا۲۰ روزه براساس عملکرد شما به همراه گزارش‌های شفاف فروش"},{icon:"action-popular",title:"صفحه اختصاصی فروشگاه",desc:"هویت فروشگاه و محصولاتتان را در یک صفحه اختصاصی به مشتریان نمایش دهید.",isSoon:!0}],u=[{icon:"comm-mobile",title:"ثبت‌نام",desc:"شماره موبایل و نوع فعالیت خود را وارد کنید."},{icon:"status-received",title:"انتخاب و فعال‌سازی کالاها",desc:"از میان کالاهای موجود در دیجی‌کالا انتخاب کنید، قیمت و موجودی را وارد کنید و آماده فروش شوید."},{icon:"alert-change-increase",title:"شروع فروش",desc:"سفارش‌ها را مدیریت کنید و کسب‌وکارتان را توسعه دهید."}],p=[{seller:"برترین کیفیت",owner:"آقای یاری",role:"موبایل و لوازم جانبی",photo:"https://dkstatics-public.digikala.com/digikala-admin-landing/0ab1c84aa17cfb12cb1a65014d9858558adf39b2_1784030767.jpg",quote:"دیجی‌کالا فروش آنلاین ما را از یک کانال جانبی به یکی از بخش‌های مهم کسب‌وکارمان تبدیل کرد؛ تا جایی که در بعضی بازه‌ها به ۵۰٪ فروش روزانه عمده رسید.",stats:[{value:"۴+ سال",label:"در دیجی‌کالا"},{value:"۵۰۰۰+",label:"کالا فعال"},{value:"۲۰۰۰+",label:"سفارش ماهانه"}]},{seller:"برگزیده",owner:"آقای ابراهیمی",role:"کفش",photo:"https://dkstatics-public.digikala.com/digikala-admin-landing/400a34a69df60d92034d79af760d28bba46cd70c_1786357171.png",quote:"دیجی‌کالا به ما کمک کرد یک صنف ۴۰ ساله و فراموش‌شده را احیا کنیم و فروش آنلاین را به یکی از اصلی‌ترین کانال‌های کسب‌وکارمان تبدیل کنیم.",stats:[{value:"۷+ سال",label:"در دیجی‌کالا"},{value:"۲۵۰۰+",label:"کالا فعال"},{value:"۱۰۰۰+",label:"سفارش ماهانه"}]},{seller:"جناب کتاب",owner:"آقای خسروانی",role:"کتاب",photo:"https://dkstatics-public.digikala.com/digikala-admin-landing/f168b83daae2e291259b3eb7b76414eb9790329b_1784547953.jpg",quote:"رشد فروش در دیجی‌کالا، تیم ما را از ۵ نفر به بیش از ۴۰ نفر رساند.",stats:[{value:"۲+ سال",label:"در دیجی‌کالا"},{value:"۳۰۰٪+",label:"رشد فروش سالانه"},{value:"۳۰۰۰+",label:"سفارش ماهانه"}]},{seller:"کوکوجم",owner:"آقای جمالی",role:"کالای خواب",photo:"https://dkstatics-public.digikala.com/digikala-admin-landing/db02edfd79f28e361158ad715c2dad9f251679aa_1784547875.jpg",quote:"کارم با رشته تحصیلی‌ام مرتبط بود و تجربه‌ای در فروش نداشتم؛ اما با دیجی‌کالا کسب‌وکارم را از صفر ساختم.",stats:[{value:"۷+ سال",label:"در دیجی‌کالا"},{value:"۲۶+ هزار",label:"خریدار"},{value:"۷۸/۸٪",label:"رضایت خریداران"}]}],x=[{icon:"shop-order",label:"مدیریت سفارش‌ها"},{icon:"status-received",label:"مدیریت موجودی"},{icon:"action-price-tag",label:"قیمت‌گذاری"},{icon:"badge-ad",label:"تبلیغات"}],h=[{title:"ثبت‌نام فروشندگان در دیجی‌کالا به چند روش انجام می‌شود؟",text:"ثبت‌نام فروشندگان در دیجی‌کالا به دو صورت انجام می‌شود:<ul><li>فروشنده حقیقی</li><li>فروشنده حقوقی</li></ul>فروشندگان باید با توجه به نوع فعالیت خود، یکی از این دو گزینه را در فرآیند ثبت‌نام انتخاب کنند."},{title:"فروشنده حقیقی برای چه کسانی مناسب است؟",text:"اگر به‌عنوان شخص حقیقی فعالیت می‌کنید و کسب‌وکار شما در قالب شرکت ثبت‌شده نیست، باید گزینه «فروشنده حقیقی» را انتخاب کنید. برای ثبت‌نام فروشندگان حقیقی، در ابتدای فرآیند ثبت‌نام نیازی به بارگذاری مدارک ثبتی شرکت وجود ندارد."},{title:"فروشنده حقوقی برای چه کسانی مناسب است؟",text:"فروشنده حقوقی مخصوص شرکت‌ها و کسب‌وکارهایی است که دارای اطلاعات ثبتی رسمی هستند؛ از جمله:<ul><li>شماره ثبت</li><li>شناسه ملی</li><li>کد اقتصادی</li></ul>اگر به‌عنوان شرکت فعالیت می‌کنید، باید در فرآیند ثبت‌نام گزینه «فروشنده حقوقی» را انتخاب کنید."},{title:"فروشندگان برای ثبت‌نام چه مدارکی باید بارگذاری کنند؟",text:"فروشندگان حقیقی نیاز به ثبت مدرک جهت ثبت‌نام ندارند. فروشندگان حقوقی برای تکمیل ثبت‌نام باید مدارک ثبتی شرکت را بارگذاری کنند. این مدارک شامل موارد زیر است:<ul><li>آخرین روزنامه رسمی شرکت</li><li>گواهی ارزش افزوده</li><li>تصویر پشت و روی کارت ملی صاحبان امضا</li></ul>بارگذاری این مدارک برای بررسی و تکمیل ثبت‌نام فروشندگان حقوقی الزامی است."},{title:"تفاوت فروشنده جدید، فروشنده اینستاگرامی/تلگرامی و فروشنده برند چیست؟",text:"در فرآیند ثبت‌نام، ممکن است از شما خواسته شود نوع فروشنده خود را مشخص کنید. این بخش برای تکمیل بهتر اطلاعات فروشنده و هدایت دقیق‌تر مسیر ثبت‌نام طراحی شده است. اگر دارای برندهای ثبت‌شده هستید، گزینه مربوط به «فروشنده برند» را انتخاب کنید. اگر فروشنده اینستاگرامی یا تلگرامی هستید و بیش از ۵۰ هزار دنبال‌کننده دارید، می‌توانید از مسیر فروشندگان اینستاگرامی/تلگرامی ثبت‌نام خود را تکمیل کنید. در غیر این صورت، کافی است گزینه «ثبت‌نام عادی» را انتخاب کرده و فرآیند ثبت‌نام خود را ادامه دهید."},{title:"اگر کد ملی قبلاً در پنل فروشندگان ثبت شده باشد چه می‌شود؟",text:"با هر کد ملی فقط یک بار امکان ثبت‌نام در پنل فروشندگان دیجی‌کالا وجود دارد. اگر هنگام ثبت‌نام با خطای تکراری بودن کد ملی مواجه شدید، به این معناست که قبلاً با این کد ملی یک ثبت‌نام آغاز شده اما فرآیند آن کامل نشده است. در این حالت، باید ثبت‌نام قبلی خود را با همان ایمیل و رمز عبور قبلی تکمیل کنید. اگر به پنل قبلی خود دسترسی ندارید، لازم است از طریق فرم «درخواست بازیابی مجدد پنل فروشندگی» اقدام کنید."},{title:"شماره موبایل احراز هویت و شماره کارت در بخش مالی باید چه شرایطی داشته باشند؟",text:"شماره موبایل احراز هویت و شماره کارت بانکی باید به نام صاحب پنل فروشندگی باشد و با کد ملی ثبت‌شده در پنل تطابق داشته باشد. در صورت عدم تطابق اطلاعات، ممکن است فرآیند احراز هویت یا تأیید اطلاعات مالی با مشکل مواجه شود."},{title:"برای تکمیل ثبت‌نام فروشندگی چه اطلاعاتی باید تکمیل شود؟",text:"برای تکمیل ثبت‌نام فروشندگی، فروشنده باید بخش‌های زیر را تکمیل کند:<ul><li>احراز هویت</li><li>قرارداد همکاری</li><li>اطلاعات مالی</li><li>نام فروشگاه</li><li>آدرس</li><li>ایمیل</li><li>مدارک موردنیاز (برای فروشنده حقوقی)</li><li>کلاس آموزشی</li></ul>تکمیل این بخش‌ها برای ادامه فرآیند ثبت‌نام و فعال‌سازی پنل فروشندگی ضروری است."}];var g=e.i(684108),b=e.i(181534);function f(){return(0,s.jsx)("section",{id:"why",className:"scroll-mt-20",children:(0,s.jsxs)("div",{className:"container-xl-w mx-auto px-4 lg:px-10 py-10 lg:py-16",children:[(0,s.jsx)("h2",{className:"text-h4-extra lg:text-h2-extra text-neutral-900 text-center mb-8",children:"چرا دیجی‌کالا؟"}),(0,s.jsx)("div",{className:"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4",children:m.map(e=>(0,s.jsxs)("article",{className:(0,g.classnames)("relative flex flex-col items-center text-center rounded-medium-plus bg-neutral-000 p-5",b.default.Benefits__card),children:[e.isSoon&&(0,s.jsx)("span",{className:(0,g.classnames)("rounded-large px-2 py-1 text-caption-strong bg-background-caution text-hint-text-caution",b.default.Benefits__soon),children:"به‌زودی"}),(0,s.jsx)("span",{className:(0,g.classnames)("flex items-center justify-center rounded-medium-plus mb-4",b.default.Benefits__iconWrap),children:(0,s.jsx)("dds-icon",{name:e.icon,size:"xs",color:"brand/primary-base"})}),(0,s.jsx)("h3",{className:(0,g.classnames)("text-h5 text-neutral-900",b.default.Benefits__title),children:e.title}),e.desc&&(0,s.jsx)("p",{className:"text-body-1 text-neutral-500 mt-2",children:e.desc}),e.options&&(0,s.jsx)("div",{className:"flex flex-col gap-2 mt-3 w-full",children:e.options.map(e=>(0,s.jsxs)("span",{className:"flex items-center justify-center gap-2 text-body-1 text-neutral-500",children:[(0,s.jsx)("dds-icon",{nam